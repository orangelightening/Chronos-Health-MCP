[Unit]
Description=Chronos Health MCP Server (Multi-Mode)
After=network.target

[Service]
Type=forking
ExecStart=%h/development/librarian-mcp/start_multi_mode.sh
ExecStop=%h/development/librarian-mcp/stop_multi_mode.sh
Restart=on-failure
RestartSec=10

# Logging — journalctl --user -u chronos-health
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
