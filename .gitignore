logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
blue-bug-maps/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Security (shouldn't be in repo anyway)
.env
.env.*
credentials.*
*.key
*.pem
*.secrets
*.creds
id_rsa
id_ed25519
Social_Media_Posts.md

# Linting cache
.ruff_cache/

# Obsidian workspace (user-specific)
.obsidian/

# Archived documentation (internal reference)
.old-docs/
archive/
working/

# Bug reports and issue tracking (private, internal use only)
bugs.md

# Internal development files (not for public repository)
CLAUDE.md

# internal library data
.librarian/

# Library registry (machine-specific, created by add_library)
global_control/.library_control/libraries.yaml

